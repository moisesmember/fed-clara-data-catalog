# Copie para .env (não versionado).

# Desenvolvimento: para onde o proxy do Vite encaminha `/api`.
CLARA_API_URL=http://127.0.0.1:8000

# Prefixo usado pelo navegador para falar com a API (mesma origem). Normalmente não muda.
VITE_API_BASE=/api

# Modo de identidade: `dev-header` (cabeçalho X-Clara-User, só para dev/test do backend).
# Produção exige um provedor real (OIDC/Entra ID) — ver README.
VITE_AUTH_MODE=dev-header
